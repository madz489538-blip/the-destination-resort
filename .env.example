# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# ADMIN_PASSWORD: Initial password for resort administrator 'admin' (defaults to ResortAdmin2026!)
ADMIN_PASSWORD="ResortAdmin2026!"

# PAYMENT INTEGRATION (Optional - when ready for live Indian payment collection)
# Leave blank for built-in Demo Simulation mode with full checkout & voucher generation.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
